      "settings": {
        "custom_liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .reviews-section {\n    background: #b82e38;\n    padding: 32px 16px;\n    width: 100%;\n    box-sizing: border-box;\n    font-family: 'Barlow', Arial, sans-serif;\n    text-align: center;\n  }\n\n  .reviews-stars-row {\n    display: flex;\n    justify-content: center;\n    gap: 8px;\n    margin-bottom: 12px;\n    color: white;\n    font-weight: 600;\n  }\n\n  .reviews-stars {\n    color: #ffd6df;\n    font-size: 20px;\n  }\n\n  .reviews-title {\n    font-size: 28px;\n    font-weight: 900;\n    color: white;\n    text-transform: uppercase;\n    margin-bottom: 24px;\n  }\n\n  .reviews-tabs {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    justify-content: center;\n    margin-bottom: 28px;\n  }\n\n  .reviews-tab {\n    padding: 10px 20px;\n    border-radius: 50px;\n    border: 2px solid #ccc;\n    background: #fff;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .reviews-tab.active {\n    background: #c0607a;\n    border-color: #c0607a;\n    color: #fff;\n  }\n\n  .reviews-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n    max-width: 1000px;\n    margin: 0 auto;\n  }\n\n  .review-card {\n    background: white;\n    padding: 20px;\n    border-radius: 16px;\n    text-align: center;\n  }\n\n  .review-card-stars {\n    color: #c0607a;\n    font-size: 18px;\n    margin-bottom: 10px;\n  }\n\n  .review-card-text {\n    font-size: 14px;\n    color: #222;\n    line-height: 1.6;\n  }\n\n  .review-card-author {\n    font-weight: 700;\n    margin-top: 8px;\n    display: block;\n  }\n\n  @media (max-width: 599px) {\n    .reviews-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<div class=\"reviews-section\">\n\n  <div class=\"reviews-stars-row\">\n    <span class=\"reviews-stars\">★★★★★</span>\n    <span>4.8 stars</span>\n  </div>\n\n  <h2 class=\"reviews-title\">Smooth Hair With Less Effort</h2>\n\n  <div class=\"reviews-tabs\">\n    <button class=\"reviews-tab active\" onclick=\"switchTab('detangle', event)\">Detangling</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('spray', event)\">Spray Function</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('comfort', event)\">Comfort</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('travel', event)\">Travel Friendly</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('repurchase', event)\">Would Buy Again</button>\n  </div>\n\n  <div class=\"reviews-grid\" id=\"reviews-grid\"></div>\n\n</div>\n\n<script>\n  const allReviews = {\n    detangle: [\n      { text: \"Brushes through my daughter's hair without tears!\", author: \"Sarah M.\" },\n      { text: \"Detangles curly hair so much faster than regular brushes.\", author: \"Lina K.\" },\n      { text: \"No more painful pulling or breakage.\", author: \"Amanda R.\" },\n    ],\n    spray: [\n      { text: \"The spray feature makes styling so easy.\", author: \"Nour A.\" },\n      { text: \"Love adding leave-in conditioner directly inside.\", author: \"Maya T.\" },\n      { text: \"Perfect mist while brushing wet hair.\", author: \"Jasmine F.\" },\n    ],\n    comfort: [\n      { text: \"Soft bristles feel super gentle on the scalp.\", author: \"Rima H.\" },\n      { text: \"Lightweight and very comfortable to hold.\", author: \"Dana P.\" },\n      { text: \"Works perfectly for everyday brushing.\", author: \"Celine B.\" },\n    ],\n    travel: [\n      { text: \"I keep it in my bag everywhere I go.\", author: \"Tina M.\" },\n      { text: \"Perfect size for travel and gym bags.\", author: \"Joelle S.\" },\n      { text: \"Easy to refill and use on the go.\", author: \"Lara N.\" },\n    ],\n    repurchase: [\n      { text: \"Buying another one for my kids.\", author: \"Yasmine D.\" },\n      { text: \"Definitely my new favorite hair tool.\", author: \"Hana K.\" },\n      { text: \"Would absolutely purchase again!\", author: \"Mira A.\" },\n    ]\n  };\n\n  function switchTab(tab, event) {\n    document.querySelectorAll('.reviews-tab').forEach(btn => btn.classList.remove('active'));\n    event.target.classList.add('active');\n\n    const reviews = allReviews[tab];\n\n    document.getElementById('reviews-grid').innerHTML = reviews.map(r => `\n      <div class=\"review-card\">\n        <div class=\"review-card-stars\">★★★★★</div>\n        <p class=\"review-card-text\">${r.text}</p>\n        <span class=\"review-card-author\">${r.author}</span>\n      </div>\n    `).join('');\n  }\n\n  switchTab('detangle', { target: document.querySelector('.reviews-tab') });\n</script>",
