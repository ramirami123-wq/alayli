ts', event)\">Results</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('blend', event)\">Blend</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('feel', event)\">Feel</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('ease', event)\">Ease of Use</button>\n    <button class=\"reviews-tab\" onclick=\"switchTab('repurchase', event)\">Would Buy Again</button>\n  </div>\n\n  <div class=\"reviews-grid\" id=\"reviews-grid\"></div>\n\n</div>\n\n<script>\n  const allReviews = {\n    results: [\n      { text: \"Gives me a full makeup look in minutes. Obsessed!\", author: \"Lara M.\" },\n      { text: \"My skin looks so glowy and fresh instantly.\", author: \"Nour K.\" },\n      { text: \"Perfect natural finish, not heavy at all.\", author: \"Maya R.\" },\n    ],\n    blend: [\n      { text: \"Blends like butter, so smooth on the skin.\", author: \"Rima H.\" },\n      { text: \"No harsh lines, just a soft natural glow.\", author: \"Sara A.\" },\n      { text: \"Super easy to blend even with fingers.\", author: \"Dina F.\" },\n    ],\n    feel: [\n      { text: \"Feels lightweight and hydrating all day.\", author: \"Hana S.\" },\n      { text: \"Not greasy at all, just soft and smooth.\", author: \"Tanya M.\" },\n      { text: \"My skin actually feels better wearing it.\", author: \"Celine A.\" },\n    ],\n    ease: [\n      { text: \"So quick to apply, perfect for busy mornings.\", author: \"Nadine T.\" },\n      { text: \"One stick replaces everything, love it.\", author: \"Rana K.\" },\n      { text: \"Great for on-the-go touch-ups.\", author: \"Joelle B.\" },\n    ],\n    repurchase: [\n      { text: \"Already ordered another shade.\", author: \"Carla N.\" },\n      { text: \"This is now my everyday product.\", author: \"Yasmine F.\" },\n      { text: \"Would definitely buy again!\", author: \"Mirna L.\" },\n    ]\n  };\n\n  function switchTab(tab, event) {\n    document.querySelectorAll('.reviews-tab').forEach(btn => btn.classList.remove('active'));\n    event.target.classList.add('active');\n\n    const reviews = allReviews[tab];\n\n    document.getElementById('reviews-grid').innerHTML = reviews.map(r => `\n      <div class=\"review-card\">\n        <div class=\"review-card-stars\">★★★★★</div>\n        <p class=\"review-card-text\">${r.text}</p>\n        <span class=\"review-card-author\">${r.author}</span>\n      </div>\n    `).join('');\n  }\n\n  switchTab('results', { target: document.querySelector('.reviews-tab') });\n</script>",
